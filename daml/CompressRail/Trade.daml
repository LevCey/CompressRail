-- A bilateral trade, signed only by its two counterparties.
--
-- Economic terms are on-ledger only as ciphertext + commitment; no operator party
-- is ever a stakeholder. Auditors (scoped regulators) may be added as observers.
module CompressRail.Trade where

import CompressRail.Types

template BilateralTrade
  with
    cptyA : Party
    cptyB : Party
    tradeRef : TradeRef
    terms : Ciphertext
    commitment : Commitment
    auditors : [Party]
  where
    signatory cptyA, cptyB
    observer auditors

    -- Either counterparty may nominate this trade into a cycle by reference. The
    -- nomination marker carries only the reference and commitment — never the terms.
    nonconsuming choice NominateIntoCycle : ContractId CycleNomination
      with
        cycleId : CycleId
        operator : Party
        nominator : Party
      controller nominator
      do
        assertMsg "nominator must be a counterparty" (nominator == cptyA || nominator == cptyB)
        create CycleNomination with cycleId; operator; nominator; tradeRef; commitment

-- An operator-visible marker that a trade has been nominated into a cycle. It
-- references the trade by ref + commitment only, so the operator learns which
-- trades are in play without seeing any economic terms.
template CycleNomination
  with
    cycleId : CycleId
    operator : Party
    nominator : Party
    tradeRef : TradeRef
    commitment : Commitment
  where
    signatory nominator
    observer operator

-- A proposal for a bilateral trade, so the trade can be agreed across two
-- participant nodes.
--
-- `BilateralTrade` has both counterparties as signatories, which a single
-- submission can only authorize while both parties are hosted on the same
-- participant: a ledger user cannot act as a party hosted elsewhere. Splitting
-- creation into propose-then-accept lets the signatory set accumulate over two
-- submissions from two nodes — the same pattern `CompressionCycle` already uses
-- when participants commit to a cycle the operator opened.
--
-- The proposal carries the same ciphertext and commitment as the trade it will
-- create. The proposer is the only signatory, so nothing binds the counterparty
-- until it accepts; and because the payload is already sealed, the proposal
-- discloses no more than the trade does.
template TradeProposal
  with
    proposer : Party
    counterparty : Party
    tradeRef : TradeRef
    terms : Ciphertext
    commitment : Commitment
    auditors : [Party]
  where
    signatory proposer
    observer counterparty

    ensure proposer /= counterparty

    -- The counterparty accepts, and the trade is created with both as signatories.
    choice Accept : ContractId BilateralTrade
      controller counterparty
      do
        create BilateralTrade with
          cptyA = proposer
          cptyB = counterparty
          tradeRef
          terms
          commitment
          auditors

    -- Either side can walk away: the counterparty declines, or the proposer
    -- withdraws before acceptance.
    choice Decline : ()
      controller counterparty
      do pure ()

    choice Withdraw : ()
      controller proposer
      do pure ()
